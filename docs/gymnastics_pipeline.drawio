<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Gymnastics-Pipeline">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Gymnastics 双视角 3D 关键点流水线（SAM3D → 三角化伪真值 → 融合 → 评估）" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="rawface" value="face 视频&#xa;raw/person/{id}/ID{id}_face.MOV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rawside" value="side 视频&#xa;raw/person/{id}/ID{id}_side.MOV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="740" y="70" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sam3d" value="① SAM3D-Body&#xa;gymnastics sam3d&#xa;逐帧 2D + 3D 关键点（每视角）&#xa;→ sam3d_body_results/person/{id}/{face,side}/*.npz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="530" y="170" width="400" height="90" as="geometry" />
        </mxCell>

        <mxCell id="split" value="② split_cycle&#xa;gymnastics align&#xa;face↔side 时间对齐 + 动作周期切分&#xa;→ alignment_record_{id}.json（offset_side_to_face, cycles）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="530" y="320" width="400" height="90" as="geometry" />
        </mxCell>

        <mxCell id="calib" value="相机标定（内参）&#xa;棋盘格 K, dist（每台相机）&#xa;local/runs/calibration_vis/IMG_*/*.npz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="1120" y="180" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="gtband" value="三角化伪真值生成路径（GT path）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontStyle=2;fontColor=#5b8a44;" vertex="1" parent="1">
          <mxGeometry x="1080" y="440" width="400" height="330" as="geometry" />
        </mxCell>
        <mxCell id="fuseband" value="融合路径（Fusion path）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=2;fontColor=#4a6a99;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="420" height="330" as="geometry" />
        </mxCell>

        <mxCell id="extr" value="③a triangulation.estimate_extrinsics&#xa;本质矩阵 RANSAC（旋转+平移方向）&#xa;+ Kabsch 单目3D 定尺度 + rig 聚类&#xa;→ estimated_extrinsics.json&#xa;[留出帧重投影 21→6 px；129逐人 + 8簇共识]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="1110" y="470" width="360" height="120" as="geometry" />
        </mxCell>

        <mxCell id="tri" value="③b triangulation.sam3d_from_split_cycle&#xa;两视角 DLT 三角化 → 3D 伪真值&#xa;sam3d_triangulated/person/…&#xa;[重投影中位 6.1 px；重建身高中位 1.60 m]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#0e3d0e;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1110" y="640" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="fuse" value="④a gymnastics fuse deterministic — 9 种确定性方法&#xa;稳定关节 Sim3 / 身体坐标系对齐 + 双视角融合&#xa;→ fuse_experiments/{method}/…/fused_sequence.npz + 指标&#xa;推荐方法：avg_body_current" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="net" value="④b fuse.rotation_aware — 学习式融合网络&#xa;自监督消融 A4 / A5 / A6&#xa;train → infer → evaluate&#xa;→ fuse_rotation_aware/…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="380" height="110" as="geometry" />
        </mxCell>

        <mxCell id="eval" value="⑤ 评估 / 分析（analysis/*, rotation_aware evaluate）&#xa;对三角化伪真值比较（similarity 逐序列 Sim3 对齐）&#xa;→ local/runs/fuse_experiments/RESULTS_SUMMARY.md&#xa;[融合 vs 单视角 −26%（100%人）；网络 ≈ 简单平均]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="530" y="830" width="400" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cls" value="⑥ project/train（可选下游）&#xa;用融合关键点（avg_body_current）做动作分类&#xa;→ local/runs/train/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;" vertex="1" parent="1">
